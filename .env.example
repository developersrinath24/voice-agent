# ---------- App ----------
APP_NAME=Healthcare Voice AI
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000
# When set, every endpoint that writes data or calls a model requires an
# X-API-Key header. Leave empty locally; set it before exposing the API publicly.
API_KEY=

# Domain used by Caddy for HTTPS. Only needed when deploying with docker compose.
DOMAIN=

# ---------- Supabase (session + message storage) ----------
# Project settings -> API. Use the service_role key on the server only.
SUPABASE_URL=
SUPABASE_KEY=

# ---------- Qdrant Cloud (vector store for the knowledge base) ----------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=clinic_knowledge

# ---------- Retrieval ----------
# How many chunks to put in the prompt, and the cosine score below which a chunk
# is treated as irrelevant. The floor prevents answers about topics the clinic
# documentation never covers.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.5

# ---------- LLM ----------
# Order in which providers are tried. Missing keys are skipped, so you can keep
# both here and only fill in the one you have.
LLM_ORDER=gemini,deepseek

# DeepSeek: deepseek-flash (V4.1 Flash) or deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Gemini fallback. gemini-3.5-flash and gemini-3.5-flash-lite both work on the
# free tier; 2.5 models are no longer available to new users.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---------- ElevenLabs (speech to text / text to speech) ----------
# Only needed for POST /voice/turn. /chat, /search and the demo front end work
# without it; leaving this empty means the demo spends no credits.
ELEVENLABS_API_KEY=
# Scribe v3 for recordings; Flash v2.5 is the low-latency voice model.
ELEVENLABS_STT_MODEL=scribe_v3
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# "Bella", a premade voice. Premade voices are usable on the free tier; most of
# the voice library returns 402 on a free key. Copy any id from the dashboard.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# 20 MB, under the proxy request body limit.
VOICE_MAX_UPLOAD_BYTES=20971520

# ---------- ElevenLabs Agents (realtime calls) ----------
# Optional. With these empty, the demo still works: the Call button returns a
# clear 503 and text chat is unaffected.
ELEVENLABS_AGENT_ID=
# Shared secret ElevenLabs sends on every custom-LLM request. Any long random
# string; it must match the "secret" entered in the agent's custom LLM settings.
# This is NOT the API key above and gives access to nothing else.
AGENT_LLM_SECRET=
# Hard caps: a call is hung up after this many seconds, and this many calls are
# handed out per UTC day. The counter is in process memory, so a restart resets it.
VOICE_MAX_CALL_SECONDS=90
VOICE_DAILY_CALL_LIMIT=10

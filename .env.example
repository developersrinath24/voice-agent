# ---------- App ----------
APP_NAME=Healthcare Voice AI
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000

# ---------- Supabase (session + message storage) ----------
# Project settings -> API. Use the service_role key on the server only.
SUPABASE_URL=
SUPABASE_KEY=

# ---------- Qdrant Cloud (vector store for the knowledge base) ----------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=clinic_knowledge

# ---------- LLM ----------
# Primary reasoning model
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Fallback provider + embeddings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ---------- ElevenLabs (speech to text / text to speech) ----------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

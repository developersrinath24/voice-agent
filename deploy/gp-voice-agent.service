[Unit]
Description=GP Clinic Voice Agent API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/voice-agent
Environment=PYTHONUNBUFFERED=1
Environment=FASTEMBED_CACHE_PATH=/home/ubuntu/.cache/fastembed
ExecStart=/home/ubuntu/voice-agent/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --proxy-headers \
    --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=20

# Hardening. If the service refuses to start after an OS upgrade, comment out
# ProtectSystem and ProtectHome first: they are the two that can surprise you.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Must exist before the service starts, or systemd fails with 226/NAMESPACE:
#   mkdir -p /home/ubuntu/.cache/fastembed
# fastembed otherwise caches to $TMPDIR/fastembed_cache, which PrivateTmp makes
# private to the unit — the model would download again on every restart.
ReadWritePaths=/home/ubuntu/.cache/fastembed
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
